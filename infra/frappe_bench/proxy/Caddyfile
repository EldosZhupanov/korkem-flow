# TLS is terminated here and nowhere else.
#
# `{$KORKEM_PUBLIC_HOST}` is the name a certificate is issued for; Caddy obtains
# and renews it automatically, which is the only reason this file is three lines
# rather than thirty.
{$KORKEM_PUBLIC_HOST} {
	tls {$KORKEM_ACME_EMAIL}

	# Frappe builds absolute URLs — including the webhook address the settings
	# screen shows an operator to paste into BotFather — from what it believes
	# its own host to be. Without these it believes it is `bench:8000`, and the
	# address on screen would be one no provider can reach.
	header_up Host {host}
	header_up X-Forwarded-Proto {scheme}
	header_up X-Forwarded-For {remote_host}

	# The webhooks, and only the webhooks.
	#
	# A public front door for a bot is not a reason to publish the desk, the
	# API or the file manager: everything else stays on the loopback port the
	# app and the emulator already use. Adding a path here is a decision
	# somebody makes on purpose.
	@webhooks path /api/method/korkem_ai.korkem_ai.integrations.telegram.webhook /api/method/korkem_ai.korkem_ai.integrations.whatsapp.webhook
	handle @webhooks {
		reverse_proxy bench:8000
	}

	# Everything else is refused rather than proxied. A 404 tells a scanner
	# nothing about what is behind this name.
	handle {
		respond 404
	}
}
