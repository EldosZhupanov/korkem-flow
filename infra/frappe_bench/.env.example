# Copy to `.env` and fill in. `.env` is gitignored and must stay that way:
# everything in the first block is a credential.
#
# Nothing here is a provider secret. Telegram tokens, WhatsApp credentials and
# the AI provider key are entered in the application, stored encrypted by
# Frappe, and never appear in a file, a log or an API response.

# --- credentials ------------------------------------------------------------
# Generate, do not invent. e.g. `openssl rand -base64 24`
MYSQL_ROOT_PASSWORD=change_me_root
# The Frappe `Administrator` password for the site created on first boot.
ADMIN_PASSWORD=change_me_admin

# --- site -------------------------------------------------------------------
# The Frappe site name. For a pilot this should be the real hostname, because
# Frappe resolves a request to a site by its `Host` header.
#   development: korkem.localhost
#   pilot:       korkem.example.com
SITE_NAME=korkem.localhost

# --- environment ------------------------------------------------------------
# development | pilot | production.
#
# Anything other than `development` turns developer mode off, refuses to enable
# the test runner, enables the scheduler, and makes every destructive demo
# fixture refuse to run. Left unset it is `development`; the pilot overlay
# (`docker-compose.pilot.yml`) sets it to `pilot` regardless of what is here.
KORKEM_ENV=development

# Gunicorn worker processes, pilot only. Rule of thumb (2 × cores) + 1, minus
# room for MariaDB if it shares the machine.
KORKEM_GUNICORN_WORKERS=2

# --- off-VHDX backups -------------------------------------------------------
# backup_offsite.sh accepts only Windows-mounted paths outside the WSL2 VHDX.
KORKEM_BACKUP_DIR=/mnt/d/korkem-backups
# Complete backup sets to retain. The source bench backups are never removed.
KORKEM_BACKUP_KEEP=7
# Optional when more than one Compose bench service is running.
# KORKEM_BENCH_CONTAINER=korkem-bench-1

# --- public front door (docker-compose.public.yml) ---------------------------
# Only needed once a domain exists. A DNS record for this name must already
# point at this machine, and ports 80 and 443 must be reachable, before the
# proxy container starts — otherwise the certificate cannot be issued.
KORKEM_PUBLIC_HOST=
# Where Let's Encrypt sends certificate expiry warnings.
KORKEM_ACME_EMAIL=

# Which surface the proxy publishes:
#   webhooks  (default) only the Telegram and WhatsApp webhook paths; every
#             other path answers 404
#   app       the whole application — API, login, desk, files, realtime — for
#             real users signing in from outside the building
KORKEM_PROXY_PROFILE=webhooks
